{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Community Platform Server",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server/server.js",
      "cwd": "${workspaceFolder}/server",
      "env": {
        "PORT": "5000",
        "JWT_SECRET": "community_platform_super_secret_jwt_key_2026",
        "ADMIN_SECRET_KEY": "ADMIN_MASTER_SECRET_2026"
      }
    }
  ]
}
